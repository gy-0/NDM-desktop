{
  "name": "ndm-desktop",
  "version": "2026.8.15",
  "private": true,
  "description": "NDM - High-Speed Download Manager for macOS",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "qa:completion": "node scripts/qa-completion.mjs",
    "qa:douyin": "node scripts/qa-douyin-access.mjs",
    "qa:thumbnail": "node scripts/qa-task-thumbnail.mjs",
    "qa:share": "node scripts/qa-share-command.mjs",
    "qa:zoom": "node scripts/qa-zoom.mjs",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac --dir",
    "deploy-app": "npm run package && rm -rf /Applications/NDM.app && cp -R dist/mac-arm64/NDM.app /Applications/NDM.app && echo 'Successfully deployed NDM.app to /Applications/NDM.app'"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "cuelume": "^0.2.2",
    "lucide-react": "^0.539.0",
    "motion": "^12.43.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "playwright": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  },
  "build": {
    "appId": "com.neatdownloadmanager.ndm",
    "productName": "NDM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../NDM/.build/release/NDMHost",
        "to": "bin/NDMHost"
      },
      {
        "from": "../NDM/extension/NDMRelay",
        "to": "extension/NDMRelay"
      },
      {
        "from": "../NDM/Vendor/Tools",
        "to": "Tools"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dir",
      "icon": "../NDM/Sources/NDMApp/Resources/Brand/NDM.icns",
      "darkModeSupport": true,
      "identity": null,
      "extendInfo": {
        "CFBundleName": "NDM",
        "CFBundleDisplayName": "NDM",
        "CFBundleShortVersionString": "2026.8.15",
        "CFBundleVersion": "2026081501"
      }
    }
  }
}
